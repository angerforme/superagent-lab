    "test:play": "node scripts/playthrough.mjs",
    "docs": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "shot": "node scripts/screenshot.mjs"
  },
  "keywords": [
    "wuxia",
    "llm",
    "game",
    "text-rpg"
  ],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.49.1"
  }
